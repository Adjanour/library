{
  "name": "library",
  "version": "0.1.1-dev",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --allow-all --watch src/main.ts",
    "start": "deno run --allow-all src/main.ts",
    "test": "deno test --allow-all",
    "check": "deno check src/**/*.ts",
    "desktop": "deno desktop --allow-all --include ../web/static src/main.ts",
    "build:frontend": "cd ../web/svelte && pnpm run build"
  },
  "imports": {
    "hono": "npm:hono@^4",
    "zod": "npm:zod@^3.24",
    "@std/path": "jsr:@std/path@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "desktop": {
    "app": {
      "name": "Library",
      "identifier": "com.bernard.library",
      "icons": {
        "linux": "./icon.png"
      }
    },
    "backend": "cef",
    "output": {
      "linux": "../dist/app"
    }
  }
}
